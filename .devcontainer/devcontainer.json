{
    "name": "QMK Firmware Environment",
    "image": "ghcr.io/qmk/qmk_cli",
    "customizations": {
        "vscode": {
            "extensions": [
                "ms-vscode.cpptools",
                "xaver.clang-format",
                "slevesque.vscode-hexdump"
            ]
        }
    },
    // This ets up QMK automatically
    "postCreateCommand": "qmk setup -y",
    "remoteUser": "root"
}