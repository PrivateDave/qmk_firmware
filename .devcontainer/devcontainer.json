{
    "name": "QMK Firmware Environment",
    "image": "ghcr.io/qmk/qmk_cli",
    "remoteUser": "vscode",
    "features": {
        "ghcr.io/devcontainers/features/common-utils:1": {
            "installZsh": false,
            "configureZshAsDefaultShell": false,
            "upgradePackages": true
        }
    },
    "customizations": {
        "vscode": {
            "extensions": [
                "ms-vscode.cpptools",
                "xaver.clang-format",
                "slevesque.vscode-hexdump"
            ]
        }
    },
    "remoteEnv": {
        "QMK_HOME": "${containerWorkspaceFolder}",
        "BASH_ENV": "~/.bashrc"
    },
    // This sets up QMK automatically
    "postCreateCommand": "qmk config user.qmk_home=$QMK_HOME && echo 'source /usr/share/bash-completion/completions/git' >> ~/.bashrc"
}